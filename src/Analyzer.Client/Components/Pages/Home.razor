@page "/"
@using Analyzer.Client.Components.Panels

<div class="dashboard-container">
    @* Верхняя панель инструментов для графа *@
    <div class="toolbar border-b mud-border-lines-default pa-3 d-flex align-center mud-theme-surface">
        
        @if (!_isSimulationMode)
        {
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Update" 
                       Class="mr-3" OnClick="RefreshGraphAsync">
                Обновить граф
            </MudButton>
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.AutoAwesomeMosaic" 
                       Class="mr-3" 
                       OnClick="AutoArrangeNodesAsync">
                Авто-раскладка
            </MudButton>
                    
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mr-3" OnClick="OpenAddComponentDialog">
                Добавить компонент
            </MudButton>

            <MudFileUpload T="IBrowserFile" Accept=".json" OnFilesChanged="ImportSystemAsync" Style="margin-top: 0;">
                <ActivatorContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Upload" Class="mr-3">
                        @if (_isImportingSystem)
                        {
                            <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true"/>
                            <MudText Class="ms-2">Загрузка...</MudText>
                        }
                        else
                        {
                            <MudText>Импорт</MudText>
                        }
                    </MudButton>
                </ActivatorContent>
            </MudFileUpload>

            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Download" Class="mr-3" OnClick="ExportSystemAsync">
                @if (_isExportingSystem)
                {
                    <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Сохранение...</MudText>
                }
                else
                {
                    <MudText>Экспорт</MudText>
                }
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Close" Class="mr-3" OnClick="ResetSimulation">
                Выйти из режима симуляции
            </MudButton>
            <MudText Typo="Typo.subtitle1" Color="Color.Error" Class="font-bold ml-4">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="MudBlazor.Size.Small" Class="mr-2" />
                Отображение каскадного отказа
            </MudText>
        }
    </div>

    @* Контейнер для графа *@
    <div class="graph-canvas">
        @if (_isLoadingGraph)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        }
        else
        {
            <CascadingValue Value="Diagram">
                <DiagramCanvas class="w-100 h-100" />
            </CascadingValue>
        }
    </div>
</div>

<ComponentPropertiesPanel 
    IsOpen="@_isComponentPropertiesPanelOpen" 
    ComponentId="@_selectedComponentId" 
    OnClose="@(() => _isComponentPropertiesPanelOpen = false)"
    OnGraphChanged="RefreshGraphAsync" 
    OnSimulateFailure="RunSimulationAsync" />

<LinkPropertiesPanel 
    IsOpen="@_isLinkPropertiesPanelOpen" 
    SelectedLink="@_selectedLinkModel"
    SourceName="@_selectedLinkSourceName" 
    TargetName="@_selectedLinkTargetName" 
    OnClose="@(() => _isLinkPropertiesPanelOpen = false)" 
    OnDelete="DeleteLink" />
