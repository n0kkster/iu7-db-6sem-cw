@page "/"
@using Analyzer.Domain.Entities
@using Analyzer.Shared.DTO;
@using Analyzer.Domain.Enums;
@using Analyzer.Client.Models;

@using Analyzer.Client.Components.Dialogs
@using Analyzer.Client.Components.Widgets

@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@inject IDialogService DialogService
@inject HttpClient Http
@using Serilog

<div class="dashboard-container">
    @* Верхняя панель инструментов для графа *@
    <div class="toolbar border-b mud-border-lines-default pa-3 d-flex align-center mud-theme-surface">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Update" Class="mr-3"
                   OnClick="RefreshGraphAsync">
            Обновить граф
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mr-3"
                   OnClick="OpenAddComponentDialog">
            Добавить компонент
        </MudButton>
        @* <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.FlashOn" OnClick="OpenSimulationPanel">
            Симуляция отказа
        </MudButton> *@

        <MudSpacer />

        <MudChip T="string" Color="Color.Success" Variant="Variant.Text">Статус: Стабилен</MudChip>
    </div>

    @* КОНТЕЙНЕР ДЛЯ ГРАФА *@
    <div class="graph-canvas">
        @if (_isLoadingGraph)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        }
        else
        {
            @* Сам холст Blazor.Diagrams *@
            <CascadingValue Value="Diagram">
                <DiagramCanvas class="w-100 h-100" />
            </CascadingValue>
        }
    </div>
</div>

@* Выдвижная панель справа для свойств компонента *@
<MudDrawer @bind-Open="@_isPropertiesPanelOpen" Anchor="Anchor.End" Elevation="1" Variant="@DrawerVariant.Temporary" Width="400px">
    <MudDrawerHeader Class="d-flex align-center justify-space-between border-b mud-border-lines-default">
        <MudText Typo="Typo.h6" Color="Color.Primary">Свойства компонента</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@OnPropertiesPanelClose" />
    </MudDrawerHeader>

    <div class="pa-4">
        @if (_isLoadingDetails)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-4" />
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" Class="mb-4" />
        }
        else if (_selectedComponent != null)
        {
            <MudTextField T="string" Label="Название" Immediate="true" @bind-Value="_selectedName" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
            <MudTextField T="string" Label="Тип" Value="@_selectedComponent.Type.ToString()" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
            <MudTextField T="string" Label="GUID" Value="@_selectedComponent.Id.ToString()" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
            <MudTextField T="string" Label="Описание" Immediate="true" @bind-Value="_selectedDesc" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />

            <MudButton Color="Color.Primary" 
                       Variant="Variant.Filled" 
                       OnClick="OnUpdateComponentAsync" 
                       Disabled="@(!_isUpdateFormValid)"
                       StartIcon="@Icons.Material.Filled.Update"
                       FullWidth="true">
                @if (_isUpdatingComponent)
                {
                    <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Сохранение...</MudText>
                }
                else
                {
                    <MudText>Обновить компонент</MudText>
                }
            </MudButton>

            <MudButton Color="Color.Error" 
                       Variant="Variant.Filled"
                       OnClick="OnDeleteComponentAsync"
                       Disabled="@(_isDeletingComponent)"
                       FullWidth="true" 
                       Class="mt-6" 
                       StartIcon="@Icons.Material.Filled.Delete">
                @if (_isDeletingComponent)
                {
                    <MudProgressCircular Class="ms-n1" Size="MudBlazor.Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Удаление...</MudText>
                }
                else
                {
                    <MudText>Удалить компонент</MudText>
                }
            </MudButton>

            <MudButton Color="Color.Error"
                       Variant="Variant.Filled" 
                       FullWidth="true" 
                       Class="mt-6" 
                       StartIcon="@Icons.Material.Filled.PowerOff">
                Сымитировать падение
            </MudButton>
        }
    </div>
</MudDrawer>

<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
    }

    .graph-canvas {
        flex-grow: 1;
        background-color: var(--mud-palette-background);
        background-image: radial-gradient(var(--mud-palette-lines-default) 1.5px, transparent 1.5px);
        background-size: 24px 24px;

        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .graph-canvas {
        flex-grow: 1;
        background-color: var(--mud-palette-background);
        background-image: radial-gradient(var(--mud-palette-lines-default) 1.5px, transparent 1.5px);
        background-size: 24px 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .default-node.selected>.mud-paper {
        border-color: var(--mud-palette-primary) !important;
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.3);
    }
</style>

@code {
    private BlazorDiagram? Diagram { get; set; } = null;
    private bool _isLoadingGraph = true;

    private bool _isPropertiesPanelOpen = false;
    private bool _isLoadingDetails = false;
    private ComponentDto? _selectedComponent;
    private bool _isUpdatingComponent = false;
    private bool _componentPropertyUpdated = false;
    private bool _isUpdateFormValid => _componentPropertyUpdated && !_isUpdatingComponent 
        && !string.IsNullOrWhiteSpace(_selectedName) && !string.IsNullOrWhiteSpace(_selectedDesc);
    private bool _isDeletingComponent = false;

    private string _selectedDesc
    {
        get
        {
            return _selectedComponent?.Description ?? "";
        }
        set
        {
            if ((_selectedComponent?.Description ?? "") != value)
            {
                _selectedComponent?.Description = value;
                _componentPropertyUpdated = true;
            }
        }
    }
    private string _selectedName
    {
        get
        {
            return _selectedComponent?.Name ?? "";
        }
        set
        {
            if ((_selectedComponent?.Name ?? "") != value)
            {
                _selectedComponent?.Name = value;
                _componentPropertyUpdated = true;
            }
        }
    }

    protected override void OnInitialized()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = false,
            Zoom = { Enabled = true, Inverse = false },
            Links = { DefaultRouter = new NormalRouter(), DefaultPathGenerator = new SmoothPathGenerator() }
        };

        Diagram = new BlazorDiagram(options);
        Diagram.RegisterComponent<ComponentModel, ComponentWidget>();

        Diagram.PointerDoubleClick += OnComponentSelected;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshGraphAsync();
            StateHasChanged();
        }
    }

    private async void OnComponentSelected(Model? model, Blazor.Diagrams.Core.Events.PointerEventArgs e)
    {
        if (model is ComponentModel componentModel && componentModel.Selected)
        {
            _componentPropertyUpdated = false;
            _isPropertiesPanelOpen = true;
            _isLoadingDetails = true;
            StateHasChanged();
            try
            {
                _selectedComponent = await Http.GetFromJsonAsync<ComponentDto>($"api/v1/components/{componentModel.ComponentId}");
            }
            finally
            {
                _isLoadingDetails = false;
                StateHasChanged();
            }
        }
    }

    private async Task OnPropertiesPanelClose()
    {
        _isPropertiesPanelOpen = false;
        _componentPropertyUpdated = false;
    }

    private async Task OnUpdateComponentAsync()
    {
        if (_selectedComponent is null)
            return;
     
        _isUpdatingComponent = true;
        _componentPropertyUpdated = false;

        await Http.PutAsJsonAsync<ComponentDto>(
            $"api/v1/components", 
            _selectedComponent
        );

        _isUpdatingComponent = false;

        await RefreshGraphAsync();
    }

    private async Task OnDeleteComponentAsync()
    {
        if (_selectedComponent is null)
            return;
     
        _isDeletingComponent = true;
        _componentPropertyUpdated = false;

        await Http.DeleteAsync($"api/v1/components/{_selectedComponent.Id}");

        _isDeletingComponent = false;

        await RefreshGraphAsync();
    }

    private async Task RefreshGraphAsync()
    {
        _isLoadingGraph = true;
        Diagram?.Nodes.Clear();
        Diagram?.Links.Clear();

        try
        {
            var components = await Http.GetFromJsonAsync<List<ComponentDto>>("api/v1/components/") ?? [];
            var links = await Http.GetFromJsonAsync<List<LinkDto>>("api/v1/links/") ?? [];

            var compDict = new Dictionary<Guid, ComponentModel>();
            RenderGraph(components, ref compDict);
            RenderLinks(links, compDict);
        }
        catch (Exception e)
        {
            Log.Error($"Ошибка во время выполнения запроса: {e.Message}");
        }
        finally
        {
            _isLoadingGraph = false;
        }
    }

    private async Task OpenAddComponentDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        var dialog = await DialogService.ShowAsync<AddComponentDialog>("Новый компонент", options);

        var result = await dialog.Result;

        if (!result?.Canceled ?? false)
        {
            await RefreshGraphAsync();
        }
    }

    private void RenderGraph(List<ComponentDto> components, ref Dictionary<Guid, ComponentModel> compDict)
    {
        int x = 100, y = 100;
        foreach (var comp in components)
        {
            var node = new ComponentModel(comp.Id, comp.Name, comp.Type, new Point(x, y));
            Diagram?.Nodes.Add(node);
            compDict.Add(comp.Id, node);

            x += 250;
            if (x > 800) { x = 100; y += 200; }
        }
    }

    private void RenderLinks(List<LinkDto> links, Dictionary<Guid, ComponentModel> compDict)
    {
        foreach (var link in links)
        {
            if (compDict.TryGetValue(link.SourceId, out var sourceNode) &&
                compDict.TryGetValue(link.TargetId, out var targetNode))
            {
                var sourcePort = sourceNode.GetPort(PortAlignment.Bottom)!;
                var targetPort = targetNode.GetPort(PortAlignment.Top)!;

                var linkModel = new LinkModel(sourcePort, targetPort)
                {
                    PathGenerator = new SmoothPathGenerator(),
                    Router = new NormalRouter(),

                    Color = link.Severity switch
                    {
                        LinkSeverity.High => "#ff3f5f", // Красный
                        LinkSeverity.Mid => "#ffb545", // Оранжевый
                        LinkSeverity.Low => "#3dcb6c", // Зеленый
                        _ => "#74718e"
                    },
                    Width = link.Severity == LinkSeverity.High ? 3 : 2
                };

                linkModel.TargetMarker = LinkMarker.Arrow;

                var label = new LinkLabelModel(linkModel, link.Protocol.ToString());
                linkModel.Labels.Add(label);

                Diagram?.Links.Add(linkModel);
            }
        }
    }

    public void Dispose()
    {
        Diagram?.PointerDoubleClick -= OnComponentSelected;
    }
}