@inherits LayoutComponentBase
@inject NavigationManager NavManager

<MudThemeProvider Theme="_myCustomTheme" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Class="@(_isThemeTransitioning ? "theme-transition" : "")">
    <MudAppBar Elevation="0" Style="backdrop-filter: blur(8px);" Class="border-b mud-border-lines-default">
        <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-3" />
        <MudText Typo="Typo.h6" Class="font-bold">Анализатор1337 | Панель управления</MudText>
        <MudSpacer />

        <MudIconButton Icon="@(_isDarkMode? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@ToggleThemeAsync" />

        <MudMenu AnchorOrigin="Origin.BottomRight" 
                 TransformOrigin="Origin.TopRight" 
                 Class="ml-4"
                 ListClass="pa-1">
            <ActivatorContent>
                <MudAvatar Color="Color.Primary" 
                           Variant="Variant.Filled" 
                           Style="cursor: pointer;">
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle" 
                             Size="MudBlazor.Size.Large"/>
                </MudAvatar>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Href="/me" 
                             Icon="@Icons.Material.Filled.Person">
                    Мой профиль
                </MudMenuItem>
                
                <MudDivider Class="my-1" />
                
                <MudMenuItem Href="/logout" 
                             Icon="@Icons.Material.Filled.Logout" 
                             IconColor="Color.Error">
                    Выйти
                </MudMenuItem>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="1" Variant="@DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always">
        <MudNavMenu Class="pt-4">
            <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People" Match="NavLinkMatch.All">Пользователи</MudNavLink>
            <MudNavLink Href="/admin/teams" Icon="@Icons.Material.Filled.Groups" Match="NavLinkMatch.All">Команды и Инвайты</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="bg-light-gray" Style="min-height: 100vh; background-color: var(--mud-palette-background);">
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    .theme-transition,
    .theme-transition * {
        transition: background-color 0.4s ease-in-out,
            color 0.4s ease-in-out,
            border-color 0.4s ease-in-out,
            fill 0.4s ease-in-out,
            box-shadow 0.4s ease-in-out !important;
    }
</style>

@code 
{
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private bool _isThemeTransitioning = false;
    
    private async Task ToggleThemeAsync()
    {
        _isThemeTransitioning = true;
        _isDarkMode = !_isDarkMode; 

        await Task.Delay(400);

        _isThemeTransitioning = false;
    }

    private readonly MudTheme _myCustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#4f46e5",
            Black = "#110e2d",
            AppbarText = "#424242",
            AppbarBackground = "rgba(255,255,255,0.8)",
            DrawerBackground = "#ffffff",
            GrayLight = "#e8e8e8",
            GrayLighter = "#f9f9f9",
            Background = "#f4f4f5",
            Surface = "#ffffff",
            LinesDefault = "#e2e8f0"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#7e6fff",
            Surface = "#1e1e2d",
            Background = "#1a1a27",
            BackgroundGray = "#151521",
            AppbarText = "#92929f",
            AppbarBackground = "rgba(26,26,39,0.8)",
            DrawerBackground = "#1a1a27",
            ActionDefault = "#74718e",
            ActionDisabled = "#9999994d",
            ActionDisabledBackground = "#605f6d4d",
            TextPrimary = "#b2b0bf",
            TextSecondary = "#92929f",
            TextDisabled = "#ffffff33",
            DrawerIcon = "#92929f",
            DrawerText = "#92929f",
            GrayLight = "#2a2833",
            GrayLighter = "#1e1e2d",
            Info = "#4a86ff",
            Success = "#3dcb6c",
            Warning = "#ffb545",
            Error = "#ff3f5f",
            LinesDefault = "#33323e",
            TableLines = "#33323e",
            Divider = "#292838",
            OverlayLight = "#1e1e2d80",
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "8px",
        }
    };

    private void Logout()
    {
        NavManager.NavigateTo("/logout", forceLoad: true);
    }
}