<style>
    .dashboard-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
    }

    .graph-canvas {
        flex-grow: 1;
        background-color: var(--mud-palette-background);
        background-image: radial-gradient(var(--mud-palette-lines-default) 1.5px, transparent 1.5px);
        background-size: 24px 24px;

        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        position: relative;
    }

    .graph-canvas {
        flex-grow: 1;
        background-color: var(--mud-palette-background);
        background-image: radial-gradient(var(--mud-palette-lines-default) 1.5px, transparent 1.5px);
        background-size: 24px 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .default-node.selected>.mud-paper {
        border-color: var(--mud-palette-primary) !important;
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.3);
    }
</style>

@code {
    private BlazorDiagram? Diagram { get; set; } = null!;
    private bool _isLoadingGraph = true;

    // Состояние боковой панели
    private bool _isPropertiesPanelOpen = false;
    private bool _isLoadingDetails = false;
    private ComponentDto? _selectedComponent;

    protected override void OnInitialized()
    {
        var options = new BlazorDiagramOptions
        {
            AllowMultiSelection = false,
            Zoom = { Enabled = true, Inverse = false },
            Links = { DefaultRouter = new NormalRouter(), DefaultPathGenerator = new SmoothPathGenerator() }
        };

        Diagram = new BlazorDiagram(options);
        Diagram.RegisterComponent<ComponentModel, ComponentWidget>();
        Diagram.SelectionChanged += OnComponentSelected;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshGraphAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshGraphAsync()
    {
        _isLoadingGraph = true;
        Diagram?.Nodes.Clear();
        Diagram?.Links.Clear();

        try
        {
            var components = await Http.GetFromJsonAsync<List<ComponentDto>>("api/component/get") ?? [];
            RenderGraph(components);
        }
        catch (Exception e)
        {
            Log.Error($"Ошибка во время выполнения запроса: {e.Message}");
        }
        finally
        {
            _isLoadingGraph = false;
        }
    }

    private async void OnComponentSelected(SelectableModel model)
    {
        // Проверяем, что кликнули именно по нашему узлу, а не по связи
        if (model is ComponentModel componentModel && componentModel.Selected)
        {
            _isPropertiesPanelOpen = true;
            _isLoadingDetails = true;
            StateHasChanged(); // Открываем панель с загрузкой

            try
            {
                // --- ТВОЙ ЗАПРОС К API ЗА ДЕТАЛЯМИ ---
                // _selectedComponent = await Http.GetFromJsonAsync<ComponentDto>($"api/component/get?id={nodeModel.ComponentId}");

                // Имитация сети
                await Task.Delay(500);
            }
            finally
            {
                _isLoadingDetails = false;
                StateHasChanged();
            }
        }
        else if (Diagram?.GetSelectedModels().Count() == 0)
        {
            // Закрываем панель, если кликнули по пустому месту холста
            _isPropertiesPanelOpen = false;
            StateHasChanged();
        }
    }

    private async Task OpenAddComponentDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        // Открываем диалог
        var dialog = await DialogService.ShowAsync<AddComponentDialog>("Новый компонент", options);

        // Ждем результат закрытия диалога
        var result = await dialog.Result;

        if (!result?.Canceled ?? false)
        {
            await RefreshGraphAsync();
        }
    }

    private void RenderGraph(List<ComponentDto> components)
    {
        int x = 100, y = 100;
        foreach (var comp in components)
        {
            var node = new ComponentModel(comp.Id, comp.Name, comp.Type, new Point(x, y));
            Diagram?.Nodes.Add(node);

            x += 250;
            if (x > 800) { x = 100; y += 200; }
        }
    }

    public void Dispose()
    {
        Diagram?.SelectionChanged -= OnComponentSelected;
    }
}