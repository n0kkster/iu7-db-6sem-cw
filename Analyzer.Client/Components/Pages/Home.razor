@page "/"
@using Analyzer.Shared.DTO;
@using Analyzer.Domain.Enums;
@using Analyzer.Client.Models;

@using Blazor.Diagrams.Core.Models.Base
@using Blazor.Diagrams.Core.PathGenerators
@using Blazor.Diagrams.Core.Routers
@using Blazor.Diagrams.Options
@inject IDialogService DialogService
@inject HttpClient Http
@using Serilog

<div class="dashboard-container">
    @* Верхняя панель инструментов для графа *@
    <div class="toolbar border-b mud-border-lines-default pa-3 d-flex align-center mud-theme-surface">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Update" Class="mr-3"
                   OnClick="RefreshGraphAsync">
            Обновить граф
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="mr-3"
                   OnClick="OpenAddComponentDialog">
            Добавить компонент
        </MudButton>
        @* <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.FlashOn" OnClick="OpenSimulationPanel">
            Симуляция отказа
        </MudButton> *@

        <MudSpacer />

        <MudChip T="string" Color="Color.Success" Variant="Variant.Text">Статус: Стабилен</MudChip>
    </div>

    @* КОНТЕЙНЕР ДЛЯ ГРАФА *@
    <div class="graph-canvas">
        @if (_isLoadingGraph)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="MudBlazor.Size.Large" />
        }
        else
        {
            @* Сам холст Blazor.Diagrams *@
            <CascadingValue Value="Diagram">
                <DiagramCanvas class="w-100 h-100" />
            </CascadingValue>
        }
    </div>
</div>

@* Выдвижная панель справа для свойств компонента *@
