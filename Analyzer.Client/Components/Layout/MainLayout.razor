@inherits LayoutComponentBase

<MudThemeProvider Theme="_myCustomTheme" @bind-IsDarkMode="_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout Class="@(_isThemeTransitioning ? "theme-transition" : "")">
    <MudAppBar Elevation="0" Style="backdrop-filter: blur(8px);" Class="border-b mud-border-lines-default">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@((e) => DrawerToggle())" />

        <MudText Typo="Typo.h6" Class="ml-2 font-bold" Color="Color.Primary">FaultAnalyzer</MudText>

        <MudSpacer />

        <MudSelect T="string" Value="@("System A (E-commerce)")" Variant="Variant.Outlined" Margin="Margin.Dense"
                   Class="mr-4" Style="max-width: 250px;">
            <MudSelectItem Value="@("System A (E-commerce)")" />
            <MudSelectItem Value="@("System B (CRM)")" />
        </MudSelect>

        <MudIconButton Icon="@(_isDarkMode? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="@ToggleThemeAsync" />
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Class="ml-4">U</MudAvatar>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="0" Variant="@DrawerVariant.Mini"
               Class="border-r mud-border-lines-default">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Дашборд</MudNavLink>
            <MudNavLink Href="/systems" Icon="@Icons.Material.Filled.AccountTree">Мои системы</MudNavLink>
            <MudNavLink Href="/team" Icon="@Icons.Material.Filled.People">Команда</MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Настройки</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="d-flex flex-column" Style="height: 100vh; overflow: hidden;">
        @Body
    </MudMainContent>
</MudLayout>

<style>
    .theme-transition,
    .theme-transition * {
        transition: background-color 0.4s ease-in-out,
            color 0.4s ease-in-out,
            border-color 0.4s ease-in-out,
            fill 0.4s ease-in-out,
            box-shadow 0.4s ease-in-out !important;
    }
</style>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;

    private bool _isThemeTransitioning = false;

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task ToggleThemeAsync()
    {
        _isThemeTransitioning = true;
        _isDarkMode = !_isDarkMode; 

        await Task.Delay(400);

        _isThemeTransitioning = false;
    }

    private readonly MudTheme _myCustomTheme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#4f46e5",
            Black = "#110e2d",
            AppbarText = "#424242",
            AppbarBackground = "rgba(255,255,255,0.8)",
            DrawerBackground = "#ffffff",
            GrayLight = "#e8e8e8",
            GrayLighter = "#f9f9f9",
            Background = "#f4f4f5",
            Surface = "#ffffff",
            LinesDefault = "#e2e8f0"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#7e6fff",
            Surface = "#1e1e2d",
            Background = "#1a1a27",
            BackgroundGray = "#151521",
            AppbarText = "#92929f",
            AppbarBackground = "rgba(26,26,39,0.8)",
            DrawerBackground = "#1a1a27",
            ActionDefault = "#74718e",
            ActionDisabled = "#9999994d",
            ActionDisabledBackground = "#605f6d4d",
            TextPrimary = "#b2b0bf",
            TextSecondary = "#92929f",
            TextDisabled = "#ffffff33",
            DrawerIcon = "#92929f",
            DrawerText = "#92929f",
            GrayLight = "#2a2833",
            GrayLighter = "#1e1e2d",
            Info = "#4a86ff",
            Success = "#3dcb6c",
            Warning = "#ffb545",
            Error = "#ff3f5f",
            LinesDefault = "#33323e",
            TableLines = "#33323e",
            Divider = "#292838",
            OverlayLight = "#1e1e2d80",
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "8px",
            @* AppbarElevation = 0, *@
            @* DrawerElevation = 0 *@
        }
    };
}